# SyncTex Environmental Variables


# Host Config
FRONTEND_URL=http://localhost
EXTERNAL_URL=http://localhost


# Frontend Vite dev server
# Used by frontend/vite.config.js when running npm run dev from frontend/.
# Put these in frontend/.env or export them in your shell for local dev.
# Not needed for production builds
DEV_ALLOWED_HOSTS=localhost,127.0.0.1
DEV_SERVER_HOST=0.0.0.0
DEV_SERVER_PORT=5173
DEV_HMR_PROTOCOL=ws
DEV_HMR_CLIENT_PORT=80


# Users service
USERS_DB_URL=postgresql://users_db_user:users_db_password@postgres-users:5432/users_db
USERS_DB_USER=users_db_user
USERS_DB_PASSWORD=users_db_password
USERS_DB=users_db
USERS_SECRET_KEY=super-secret-key-change-in-production
USERS_INTERNAL_API_KEY=super-secret-key-change-in-production
USERS_INTERNAL_API_URL=http://users-service:8001


# Projects Service
PROJECTS_DB_USER=projects_db_user
PROJECTS_DB_PASSWORD=projects_db_password
PROJECTS_DB=projects_db
PROJECTS_DB_URL=postgresql://projects_db_user:projects_db_password@postgres-projects:5432/projects_db
PROJECTS_PORT=8003
PROJECTS_SERVICE_URL=http://projects-service:8003
PROJECTS_INTERNAL_API_KEY=super-secret-key


# Assistant Service
ASSISTANT_DB_USER=assistant_db_user
ASSISTANT_DB_PASSWORD=assistant_db_password
ASSISTANT_DB=assistant_db
ASSISTANT_DB_URL=postgresql+asyncpg://assistant_db_user:assistant_db_password@postgres-assistant:5432/assistant_db
ASSISTANT_DB_SYNC_URL=postgresql+psycopg2://assistant_db_user:assistant_db_password@postgres-assistant:5432/assistant_db
ASSISTANT_ENCRYPTION_KEY=super-secret-key
VOYAGE_API_KEY=voyage-api-key


# Github Oauth
GITHUB_CLIENT_ID=github-client-id
GITHUB_CLIENT_SECRET=github-client-secret


# MinIO Credentials
MINIO_ROOT_USER=minio_root_user
MINIO_ROOT_PASSWORD=minio_root_password
MINIO_ENDPOINT=minio:9000 # Internal service access
MINIO_EXTERNAL_ENDPOINT=http://localhost/minio/api # External access through nginx
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key


# Collab Service
COLLAB_SERVICE_BIND_ADDR=0.0.0.0:8080
COLLAB_UPLOAD_DEBOUNCE_MS=2000
COLLAB_UPLOAD_MAX_SEC=30
